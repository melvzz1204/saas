# Backend origin baked into the production build.
# Vite replaces the %VITE_API_URL% placeholder in every HTML page at build time,
# and src/util/apiBase.js reads window.VITE_API_URL to set window.ApiBase.
#
# This points the Vercel-hosted frontend at the Render backend.
# NOTE: This is NOT a secret — the backend URL ships in the public client bundle.
VITE_API_URL=https://saas-gphe.onrender.com
